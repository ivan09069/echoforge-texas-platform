    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "ws": "^8.18.0",
    "brace-expansion": ">=2.1.7",
    "follow-redirects": ">=1.16.2",
    "glob": ">=14.0.2",
    "minimatch": ">=11.0.1",
    "serialize-javascript": "^7.1.3",
    "mocha": {
      "serialize-javascript": "^7.1.3",
      "diff": "^8.0.3"
    },
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "undici": ">=6.29.1",
    "zod": ">=4.6.6",
    "diff": "^8.0.3",
    "tmp": "0.2.5"
  }
